# Copy to .env and provide local values. Never commit .env.
ConnectionStrings__GymLink=Server=localhost;Database=230038;Trusted_Connection=True;TrustServerCertificate=True

Jwt__Issuer=GymLink
Jwt__Audience=GymLink.Clients
Jwt__SigningKey=replace-with-a-local-key-of-at-least-32-bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

PasswordReset__CodePepper=replace-with-a-separate-local-key-of-at-least-32-bytes

RabbitMq__Enabled=false
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__Username=guest
RabbitMq__Password=guest
RabbitMq__Exchange=gymlink.events
RabbitMq__NotificationQueue=gymlink.notifications.v1
RabbitMq__EmailQueue=gymlink.email.v1
RabbitMq__DeadLetterExchange=gymlink.dead-letter
RabbitMq__BatchSize=50
RabbitMq__PollIntervalSeconds=2
RabbitMq__LeaseSeconds=30

Smtp__Host=localhost
Smtp__Port=1025
Smtp__UseSsl=false
Smtp__Username=
Smtp__Password=
Smtp__SenderEmail=no-reply@gymlink.local
Smtp__SenderName=GymLink

Geocoding__Enabled=true
Geocoding__BaseUrl=https://nominatim.openstreetmap.org
Geocoding__UserAgent=GymLink/1.0 (contact: replace-with-your-email@example.com)
Geocoding__ContactEmail=replace-with-your-email@example.com
Geocoding__TimeoutSeconds=10
Geocoding__CacheHours=24
Geocoding__MinimumIntervalMilliseconds=1000

# Stripe sandbox only. The API return pages reopen the Android app through
# gymlink://payment/result; never commit real keys.
Stripe__Enabled=false
Stripe__SecretKey=sk_test_replace_me
Stripe__WebhookSecret=whsec_replace_me
Stripe__SuccessUrl=http://10.0.2.2:62287/payments/stripe/success
Stripe__CancelUrl=http://10.0.2.2:62287/payments/stripe/cancel

Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

Seed__Enabled=false
Seed__DefaultPassword=Test123!
